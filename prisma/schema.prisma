generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // "admin" or "user"
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Assinatura
  subscriptionStatus    String    @default("inactive") // "active", "inactive"
  subscriptionPlatform  String?   // "lowfy", "cakto", "efi"
  subscriptionExpiresAt DateTime?

  // Segurança
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  favorites     Favorite[]
  watchProgress WatchProgress[]
}

// Push subscriptions (Web Push)
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  userAgent String?
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())

  @@index([userId])
}

// Rate limiting por IP em endpoints sensíveis (auth, register)
model RateLimit {
  id        String   @id @default(cuid())
  key       String   // ex: "login:1.2.3.4" ou "register:1.2.3.4"
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@unique([key])
  @@index([resetAt])
}

model GuestToken {
  id           String   @id @default(cuid())
  token        String   @unique
  label        String
  durationDays Int      @default(30) // 14 ou 30
  /// Vazio = nunca vence. Usado pelos links fixos de divulgação de série.
  expiresAt    DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  /// Quando preenchido, o convite libera só essa série. Vazio = catálogo todo.
  movieId      String?
  movie        Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

// Pagamentos Efí (Pix, cartão e boleto)
model Payment {
  id        String @id @default(cuid())
  provider  String @default("efi")
  method    String // "pix", "card", "boleto"
  plan      String // "mensal", "trimestral", "anual"
  amount    Int // centavos
  status    String @default("pending") // "pending", "paid", "failed", "expired", "refunded"

  email String
  name  String
  cpf   String?

  txid     String? @unique // Pix
  chargeId String? @unique // Cobranças (cartão/boleto)

  checkoutUrl String? // link do boleto
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([status])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  movies MovieCategory[]
}

model Movie {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  thumbnail   String
  videoUrl    String
  bannerUrl   String?
  year        Int?
  duration    String?
  rating      Float?   @default(0)
  featured    Boolean  @default(false)
  status      String   @default("active") // "active", "draft", "inactive"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories    MovieCategory[]
  favorites     Favorite[]
  watchProgress WatchProgress[]
  analytics     MovieAnalytics[]
  guestTokens   GuestToken[]
}

model MovieCategory {
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId    String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([movieId, categoryId])
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   String
  createdAt DateTime @default(now())

  @@unique([userId, movieId])
}

model WatchProgress {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   String
  progress  Float    @default(0) // percentage 0-100
  timestamp Float    @default(0) // seconds
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, movieId])
}

model MovieAnalytics {
  id        String   @id @default(cuid())
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   String
  eventType String   // "watch_start", "watch_complete", "view"
  createdAt DateTime @default(now())
}

model SiteSettings {
  id          String @id @default("main")
  siteName    String @default("Dorama Flix")
  siteTagline String @default("Filmes e Séries Asiáticas")
  logoUrl     String?
  heroTitle   String?
  heroSubtitle String?
  primaryColor String @default("#e50914")
  updatedAt   DateTime @updatedAt
}
