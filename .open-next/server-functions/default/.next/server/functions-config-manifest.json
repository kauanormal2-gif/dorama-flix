{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/static|_next\\/image|favicon.ico|api\\/).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/static|_next/image|favicon.ico|api/).*)"
        }
      ]
    },
    "/api/pagamentos/boleto": {},
    "/api/pagamentos/cartao": {},
    "/api/pagamentos/pix": {},
    "/api/pagamentos/pix/[txid]": {},
    "/api/webhooks/efi/cobrancas": {},
